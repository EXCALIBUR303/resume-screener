# ─────────────────────────────────────────────────────────────────────────────
#  Secure AI Resume Screener — environment contract
#  Copy to .env and fill in.  NEVER commit .env.
#  Generate secrets with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
APP_ENV=dev                       # dev | test | prod. Anything but "dev" refuses to boot on default secrets.
APP_NAME=resume-screener
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR. DEBUG never redacts less — redaction is unconditional.
API_BASE_URL=https://localhost
WEB_BASE_URL=https://localhost

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=screener
POSTGRES_PASSWORD=CHANGE_ME_dev_only
POSTGRES_DB=screener
POSTGRES_HOST=db
POSTGRES_PORT=5432
# DATABASE_URL is DERIVED from the four POSTGRES_* values above by settings.py.
# Do not set it here — a literal copy of the password drifts the moment you rotate it.
# Override only to point at an external database (e.g. Neon), and then it wins over the parts.
# DATABASE_URL=
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=15000     # Kills runaway queries. Do not raise without a reason.

# ── Cryptography ─────────────────────────────────────────────────────────────
APP_KEK=CHANGE_ME_base64_32_bytes # Key-encryption key. Wraps every per-record data key. Losing it = losing all encrypted data.
APP_KEK_VERSION=1                 # Bump + run `make rotate-kek` to rotate. Old versions must stay available until rotation completes.
JWT_SECRET=CHANGE_ME_base64_32_bytes
JWT_ALGORITHM=HS256               # Pinned. The decoder accepts exactly this and nothing else.
JWT_ISSUER=resume-screener
JWT_AUDIENCE=resume-screener-api
ACCESS_TOKEN_TTL_SECONDS=900      # 15 min.
REFRESH_TOKEN_TTL_SECONDS=1209600 # 14 days. Rotating; reuse revokes the whole family.

# ── Authentication ───────────────────────────────────────────────────────────
AUTH_LOCAL_ENABLED=true           # Email+password path. Keep true for the offline demo; false in any shared deployment.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536      # 64 MiB.
ARGON2_PARALLELISM=4
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ── File storage ─────────────────────────────────────────────────────────────
STORAGE_BACKEND=local             # local | s3. S3 covers R2/Supabase via an S3-compatible endpoint.
STORAGE_LOCAL_PATH=/data/files    # Contains quarantine/ and clean/. Keys are sha256, never user filenames.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Upload limits (enforced at Caddy, the API, AND the worker) ───────────────
UPLOAD_MAX_BYTES=10485760         # 10 MB.
UPLOAD_MAX_PAGES=30
UPLOAD_MAX_CHARS=500000
UPLOAD_ALLOWED_MIME=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
ZIP_MAX_RATIO=100                 # Uncompressed:compressed. Above this = zip bomb.
ZIP_MAX_ENTRIES=2000
ZIP_MAX_UNCOMPRESSED_BYTES=104857600
UPLOAD_QUOTA_PER_USER_HOUR=100

# ── Malware scanning (optional compose profile) ──────────────────────────────
CLAMAV_ENABLED=false              # Needs ~1-2 GB RAM for signatures. On in CI's security job.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ── Parsing / OCR ────────────────────────────────────────────────────────────
OCR_ENABLED=true
OCR_TEXT_DENSITY_THRESHOLD=50     # Chars/page below this triggers OCR.
OCR_MIN_CONFIDENCE=60             # Below this: flag needs_manual_review and apply a ranking penalty.
PARSE_TIMEOUT_SECONDS=60
PARSE_MEMORY_LIMIT_MB=1024

# ── PII redaction ────────────────────────────────────────────────────────────
REDACTION_ENABLED=true            # NEVER false outside a unit test. A startup assert enforces this in prod.
PRESIDIO_ENTITIES=PERSON,EMAIL_ADDRESS,PHONE_NUMBER,LOCATION,DATE_TIME,NRP,US_SSN,IBAN_CODE,CREDIT_CARD,URL
REDACT_PROTECTED_ATTRIBUTES=true  # Gender, marital status, nationality, religion, disability, photo presence.
REDACT_GRADUATION_YEARS=true      # A common age proxy. Default on.
SPACY_MODEL=en_core_web_lg

# ── LLM gateway ──────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama               # ollama | openai_compatible | stub. CI and all tests use "stub".
LLM_MODEL=qwen3:8b                # Fallback if unavailable: qwen2.5:7b-instruct
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=                      # Only for openai_compatible. Leave empty for Ollama.
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_MONTHLY_TOKENS=0          # 0 = unlimited (safe for local). Set a real number before ever using a paid endpoint.
LLM_CIRCUIT_BREAKER_FAILURES=5    # Consecutive failures before the breaker opens.

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384                 # Must match the pgvector column. Startup refuses to boot on a mismatch.
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# ── Scoring weights (org_admin can override per-org; these are the defaults) ─
SCORE_WEIGHT_SKILL=0.30
SCORE_WEIGHT_EXPERIENCE=0.20
SCORE_WEIGHT_SEMANTIC=0.20
SCORE_WEIGHT_RUBRIC=0.30          # The only model-influenced term. Cap it deliberately.
SCORE_PENALTY_LOW_OCR=0.10
SCORE_PENALTY_UNVERIFIED=0.15
SCORE_PENALTY_INJECTION_SUSPECTED=0.20

# ── Queue / workers ──────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=500
WORKER_MAX_ATTEMPTS=5
WORKER_LEASE_TIMEOUT_SECONDS=300  # A "running" job older than this is reclaimed by the sweeper.
WORKER_CONCURRENCY_PER_ORG=4

# ── Retention ────────────────────────────────────────────────────────────────
DEFAULT_RETENTION_DAYS=180
RETENTION_JOB_CRON=0 3 * * *
RETENTION_DRY_RUN=true            # Start true. Flip to false only after you've read a dry-run report.

# ── Observability (optional profile) ─────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Feature flags ────────────────────────────────────────────────────────────
FEATURE_INTERVIEW_COPILOT=true
FEATURE_AUDIO_ANSWERS=false       # V2. Requires faster-whisper.
FEATURE_URL_IMPORT=false          # SSRF surface. Off by default; read the threat model before enabling.
