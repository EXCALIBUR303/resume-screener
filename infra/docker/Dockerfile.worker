# syntax=docker/dockerfile:1
FROM python:3.12-slim AS base
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app

FROM base AS deps
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv
COPY apps/api/requirements.lock ./
RUN uv pip install --system --no-cache --require-hashes -r requirements.lock

FROM base AS runtime
# tesseract-ocr: the OCR engine.  poppler-utils: pdftoppm, which rasterises PDFs
# for OCR (chosen over PyMuPDF to keep the project off AGPL — see ADR-0002).
# libmagic1: content sniffing.
# See Dockerfile.api: `upgrade` closes base-image CVEs Trivy gates on.
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends \
      tesseract-ocr tesseract-ocr-eng poppler-utils libmagic1 \
 && rm -rf /var/lib/apt/lists/*

# The spaCy model must be baked in: this container has no network at runtime,
# so it cannot download anything. en_core_web_sm (15 MB) rather than _lg
# (560 MB) — NER is one of four redaction layers, not the load-bearing one, and
# measured recall is 100% on the seeded-marker set with the small model.
COPY --from=deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin
RUN python -m spacy download en_core_web_sm

# The embedding model, likewise baked in: this container has no network at
# runtime and fastembed would otherwise try to fetch weights on first use.
ENV FASTEMBED_CACHE_PATH=/opt/models
RUN mkdir -p /opt/models \
 && python -c "from fastembed import TextEmbedding; \
TextEmbedding(model_name='BAAI/bge-small-en-v1.5', cache_dir='/opt/models')"

RUN useradd --create-home --uid 10002 worker
COPY --chown=worker:worker apps/api/src ./src
# Prompts are behaviour, and this container has no network.
COPY --chown=worker:worker prompts ./prompts
ENV PROMPTS_DIR=/app/prompts
RUN mkdir -p /data/files && chown -R worker:worker /data /opt/models
ENV PYTHONPATH=/app/src
USER worker
CMD ["python", "-m", "screener_api.worker"]
