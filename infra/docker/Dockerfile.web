# syntax=docker/dockerfile:1
#
# apps/web builds with `output: "standalone"` (next.config.ts) — a Node
# server, not a static export — because it needs a real backend for auth and
# API calls rather than being pre-rendered. That shape does not fit Cloudflare
# Pages' zero-config Next.js support, which wants static output or their own
# adapter. It fits a container directly, which is what this builds.
FROM node:22-slim AS base
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

FROM base AS deps
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY apps/web ./
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, not
# read from the running container — so this has to be a build argument, not
# an environment variable handed to `docker run`. On Hugging Face Spaces, a
# Docker Space's own "Variables and secrets" are exposed as build args
# automatically, which is what supplies this without editing the Dockerfile.
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
RUN npm run build

FROM base AS runtime
RUN useradd --create-home --uid 10003 webuser
# `output: "standalone"` traces the minimal set of node_modules the server
# actually needs and writes a self-contained server.js — this is why runtime
# does not run `npm install` at all, only copies what build already traced.
COPY --from=build --chown=webuser:webuser /app/.next/standalone ./
COPY --from=build --chown=webuser:webuser /app/.next/static ./.next/static
USER webuser
# HOSTNAME matters, not just PORT: Next.js standalone's default HOSTNAME is
# localhost, which is unreachable from outside the container. PORT is
# deliberately NOT fixed to one value here — set it as a Space variable to
# match whatever port that host's health check expects (Hugging Face Spaces
# default to 7860).
ENV HOSTNAME=0.0.0.0 PORT=3000
EXPOSE 3000
CMD ["node", "server.js"]
